{
  "name": "ev-invoice",
  "version": "1.7.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "lint": "eslint *.{ts,mjs} \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint:fix": "npm run lint -- --fix",
    "test": "vitest run --coverage",
    "build": "tsc",
    "postbuild": "cp package.json dist/",
    "openapi": "APP_PROFILE=example node dist/openapi",
    "start": "tsc && APP_PROFILE=local node dist/local",
    "start:dev": "APP_PROFILE=local tsc-watch --onSuccess \"node dist/local\""
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.1136.0",
    "@codegenie/serverless-express": "^5.0.0",
    "@nestjs/common": "^11.2.5",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.5",
    "@nestjs/platform-express": "^11.2.5",
    "@nestjs/swagger": "^11.4.7",
    "nestjs-pino": "^4.6.1",
    "pino": "^10.3.1"
  },
  "updates-blocked": [
    "@nestjs/* 11.x -> 12.x and @nestjs/config 4 -> 12: Nest 12 is ESM-only, nestjs-pino (CJS) loads it via require(esm), which AWS Lambda disables (ERR_REQUIRE_ESM). Wait until nestjs-pino ships an ESM-compatible build, then upgrade all @nestjs/* together",
    "nestjs-pino 4.6.1 -> 5.x: v5 relies on require(esm), same Lambda problem as above",
    "typescript 6.0.3 -> 7.x: TS 7 has no JS compiler API and typescript-eslint peer range is <6.1.0. Wait until typescript-eslint supports TS 7, then upgrade",
    "@types/node 24.x -> 26.x: Node must stay <= 24 (Lambda runtime nodejs24.x)"
  ],
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.6.1",
    "@types/aws-lambda": "^8.10.159",
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.4",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.11.0",
    "eslint-plugin-import-x": "^4.17.1",
    "pino-pretty": "^13.1.3",
    "tsc-watch": "^7.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.49.0",
    "vitest": "^5.0.1"
  },
  "allowScripts": {
    "@scarf/scarf": false,
    "fsevents": true,
    "unrs-resolver": false
  },
  "overrides": {
    "multer": "^2.4.0"
  }
}
