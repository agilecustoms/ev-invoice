{
  "name": "ev-invoice",
  "version": "1.6.1",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "lint": "eslint *.{ts,mjs} \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint:fix": "npm run lint -- --fix",
    "test": "vitest run --coverage",
    "build": "tsc",
    "postbuild": "cp package.json dist/",
    "openapi": "APP_PROFILE=example node dist/openapi",
    "start": "tsc && APP_PROFILE=local node dist/local",
    "start:dev": "APP_PROFILE=local tsc-watch --onSuccess \"node dist/local\""
  },
  "dependencies": {
    "@codegenie/serverless-express": "^5.0.0",
    "@nestjs/common": "^12.0.3",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.3",
    "@nestjs/platform-express": "^12.0.3",
    "@nestjs/swagger": "^12.0.1",
    "nestjs-pino": "^5.2.0",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.6.1",
    "@types/aws-lambda": "^8.10.159",
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.4",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.11.0",
    "eslint-plugin-import-x": "^4.17.1",
    "pino-pretty": "^13.1.3",
    "tsc-watch": "^7.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.49.0",
    "vitest": "^5.0.1"
  },
  "allowScripts": {
    "@scarf/scarf": false,
    "fsevents": true,
    "unrs-resolver": false
  }
}
