{
  "name": "ev-invoice",
  "version": "1.34.16",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "lint": "eslint *.{ts,mjs} \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint:fix": "npm run lint -- --fix",
    "test": "vitest run --coverage",
    "build": "tsc",
    "postbuild": "cp package.json dist/",
    "openapi": "APP_PROFILES=openapi node dist/openapi",
    "start:localaws": "tsc && APP_PROFILES=dev,localaws,localaws-dev AWS_PROFILE=ac-ev-prod-invoice node dist/run_local",
    "start:localaws:watch": "APP_PROFILES=dev,localaws,localaws-dev AWS_PROFILE=ac-ev-prod-invoice tsc-watch --onSuccess \"node dist/run_local\""
  },
  "dependencies": {
    "@aws-sdk/client-scheduler": "^3.1169.0",
    "@aws-sdk/client-secrets-manager": "^3.1169.0",
    "@codegenie/serverless-express": "^5.0.0",
    "@js-temporal/polyfill": "^0.5.1",
    "@nestjs/common": "^12.5.0",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.5.0",
    "@nestjs/platform-express": "^12.5.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "libphonenumber-js": "^1.13.16",
    "nestjs-pino": "^5.3.1",
    "pino": "^10.4.0"
  },
  "devDependencies": {
    "@nestjs/swagger": "^12.1.2",
    "@stylistic/eslint-plugin": "^6.0.0",
    "@types/aws-lambda": "^8.10.164",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.15.0",
    "eslint-plugin-import-x": "^4.18.1",
    "pino-pretty": "^13.2.0",
    "reflect-metadata": "^0.2.2",
    "tsc-watch": "^7.2.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "updates-blocked": [
    "typescript 6.0.3 -> 7.x: TS 7 has no JS compiler API and typescript-eslint peer range is <6.1.0. Wait until typescript-eslint supports TS 7, then upgrade",
    "@types/node 24.x -> 26.x: Node must stay <= 24 (Lambda runtime nodejs24.x is the latest GA runtime; nodejs26.x is public-preview only as of 2026-09)",
    "@js-temporal/polyfill can be removed (use the native globalThis.Temporal instead) once Lambda runs on Node 26, which has Temporal enabled by default. Node <= 24 only has it behind --harmony-temporal, which is not an allowed NODE_OPTIONS flag"
  ],
  "allowScripts": {
    "@scarf/scarf": false,
    "fsevents": true,
    "unrs-resolver": false
  }
}
