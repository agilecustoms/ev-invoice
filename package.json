{
  "name": "ev-invoice",
  "version": "1.3.2",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "lint": "eslint *.{ts,mjs} \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint:fix": "npm run lint -- --fix",
    "test": "vitest run --coverage",
    "build": "tsc",
    "postbuild": "cp package.json dist/",
    "openapi": "APP_PROFILE=example node dist/openapi",
    "start": "tsc && APP_PROFILE=local node dist/local",
    "start:dev": "APP_PROFILE=local tsc-watch --onSuccess \"node dist/local\""
  },
  "dependencies": {
    "pino": "^10.3.1",
    "@codegenie/serverless-express": "^5.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/platform-express": "^11.1.11",
    "@nestjs/swagger": "^11.2.3",
    "nestjs-pino": "^4.4.0"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.6.1",
    "@types/aws-lambda": "^8.10.159",
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.4",
    "@vitest/coverage-v8": "^4.0.15",
    "eslint": "^9.39.2",
    "eslint-plugin-import": "^2.32.0",
    "pino-pretty": "^13.1.3",
    "tsc-watch": "^7.0.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.49.0",
    "vitest": "^4.0.0"
  },
  "allowScripts": {
    "@scarf/scarf": false,
    "fsevents": true
  }
}
